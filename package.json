{
  "name": "space-weather",
  "version": "0.1.1",
  "description": "NOAA Space Weather Prediction Center products, fetched, parsed and published: geomagnetic storms, radio blackouts, aurora and HF absorption grids, and the map webapp that draws them.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./parse": "./dist/parse.js",
    "./paths": "./dist/paths.js",
    "./config": "./dist/config.js",
    "./endpoints": "./dist/endpoints.js",
    "./publisher": "./dist/publisher.js",
    "./meter": "./dist/meter.js",
    "./refreshPolicy": "./dist/refreshPolicy.js",
    "./telemetry": "./dist/telemetry.js",
    "./noaa/client": "./dist/noaa/client.js",
    "./cache/*": "./dist/cache/*.js",
    "./products/*": "./dist/products/*.js",
    "./browser/*": "./dist/browser/*.js",
    "./projection": "./public/projection.js",
    "./mapRaster": "./public/mapRaster.js",
    "./spaceMap": "./public/spaceMap.js",
    "./geo": "./public/geo.js",
    "./public/*": "./public/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "docs/noaa-products.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prebuild": "node scripts/sync-coastline.mjs",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "watch": "npm run build -- -w",
    "test": "vitest run",
    "dev:webapp": "node scripts/mock-webapp.mjs",
    "dev:webapp:stop": "node scripts/webapp-ctl.mjs stop",
    "dev:webapp:list": "node scripts/webapp-ctl.mjs list",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "node scripts/sync-coastline.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/space-weather.git"
  },
  "keywords": [
    "noaa",
    "swpc",
    "space-weather",
    "aurora",
    "kp-index",
    "geomagnetic-storm",
    "solar-flare",
    "hf-radio",
    "d-rap",
    "signalk"
  ],
  "author": "mark-brannan",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "coast-wright": "^0.0.1-alpha.0",
    "coastlines": "^0.0.1-alpha.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
