{
  "name": "signalk-noaa-space-weather",
  "version": "0.5.1",
  "description": "Fetch *space* weather and alerts/advisory from NOAA Space Weather Prediction Service (SWPC)",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "public",
    "docs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "build": "tsc",
    "watch": "npm run build -- -w",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark-brannan/signalk-noaa-space-weather.git"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-weather",
    "signalk-webapp"
  ],
  "signalk": {
    "displayName": "NOAA Space Weather",
    "appIcon": "./icon.svg",
    "screenshots": [
      "./docs/screenshots/webapp.png",
      "./docs/screenshots/plugin-configuration.png",
      "./docs/screenshots/data-browser.png",
      "./docs/screenshots/notifications.png"
    ]
  },
  "author": "mark-brannan",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
