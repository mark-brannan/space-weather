{
  "compilerOptions": {
    // nodenext matches how this package is actually loaded: it is "type":
    // "module" with an exports map, and the server resolves it through Node's
    // ESM/CJS interop. The old "node" (node10) resolver predates all of that
    // and was removed in TypeScript 7.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "dist",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test"]
}
